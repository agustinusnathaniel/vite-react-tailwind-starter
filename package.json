    "commit-and-tag-version": "^13.1.2",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "typescript": "^6.0.3",
    "ultracite": "7.10.6",
    "vite": "catalog:",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
